# Copy to .env and edit. Read by docker compose.

# Where Caddy is published on the host. 127.0.0.1 = this machine only (e.g.
# for cloudflared running on the host); 0.0.0.0 = LAN / Tailscale too.
KORE_BIND=127.0.0.1
KORE_PORT=8080

# Host directory holding the database and files (must exist, owned by
# KORE_UID:KORE_GID; initialize it once with `kore init`, see README).
KORE_DATA_DIR=/mnt/mirror/kore

# User and group the API runs as; files in KORE_DATA_DIR are owned by them.
KORE_UID=1000
KORE_GID=1000
