# Copy to .env and edit (install.sh does this for you). Read by docker compose.

# First admin account, created on the first start. Use a real password
# (at least 8 characters); Kore refuses to start with "change-me".
KORE_ADMIN_EMAIL=admin@example.com
KORE_ADMIN_PASSWORD=change-me

# Host directory holding the database and files. It must exist, be owned by
# KORE_UID:KORE_GID and be initialized once with `kore init` (install.sh does
# both; see README).
KORE_DATA_DIR=/srv/kore

# Where Caddy is published on the host. 127.0.0.1 = this machine only (e.g.
# for cloudflared running on the host); 0.0.0.0 = LAN / Tailscale too.
KORE_BIND=127.0.0.1
KORE_PORT=8080

# User and group the API runs as; files in KORE_DATA_DIR are owned by them.
KORE_UID=1000
KORE_GID=1000

# Image tag to run (a release such as 0.1.0, or latest).
KORE_VERSION=latest

# Subnet of the Docker network Caddy publishes on. Connections from this
# host arrive from its gateway and are the only ones whose X-Forwarded-* and
# CF-Connecting-IP headers are trusted (e.g. cloudflared on the host). Change
# it only if it collides with an existing network.
KORE_SUBNET=172.31.255.0/24

# --- Sign in with Kore ID (optional; see README, "Kore ID") ---------------
# Public address people use to reach Kore, no trailing slash. The OIDC
# redirect URI is KORE_PUBLIC_URL/api/auth/oidc/callback (register it,
# KORE_PUBLIC_URL/login as post-logout redirect, and
# KORE_PUBLIC_URL/api/auth/oidc/backchannel-logout as backchannelLogoutUri,
# for client "kore" in Kore ID).
#KORE_PUBLIC_URL=https://kore.example.com
# Kore ID's address. Setting it turns "Sign in with Kore ID" on.
#KORE_OIDC_ISSUER=https://id.example.com
#KORE_OIDC_CLIENT_ID=kore
#KORE_OIDC_CLIENT_SECRET=
# Create an account on a person's first Kore ID login (default true).
#KORE_OIDC_AUTO_PROVISION=true
# Let a first Kore ID login adopt the existing, not yet linked account with
# the same email, only when Kore ID marks the email verified
# (email_verified = true). Default true; false = link accounts by hand.
#KORE_OIDC_LINK_BY_EMAIL=true
# Email + password login. Set false to make Kore ID the only way in (needs
# the settings above; link your admin account first, or you lock yourself out).
#KORE_LOCAL_LOGIN=true
