# /etc/systemd/system/koremind.service
# Runs the KoreMind backend (:8787) and web UI (:3210). See docs/deployment-linux.md.
[Unit]
Description=KoreMind personal assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The user whose `claude auth login` (and OpenCode state) KoreMind uses. Claude runs as this user.
User=koremind
Group=koremind
WorkingDirectory=/opt/koremind
EnvironmentFile=/etc/koremind/koremind.env
# systemd gives services a minimal PATH: bun, claude and opencode live in that user's home.
Environment=PATH=/home/koremind/.bun/bin:/home/koremind/.local/bin:/home/koremind/.opencode/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/koremind
ExecStart=/home/koremind/.bun/bin/bun run start
# Backend only, when the web UI runs elsewhere (for example in Docker):
#ExecStart=/home/koremind/.bun/bin/bun run backend/src/index.ts
Restart=on-failure
RestartSec=3
# Stop the whole group so no engine process (OpenCode, a running claude) outlives the backend.
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
