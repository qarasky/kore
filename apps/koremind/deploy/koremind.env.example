# /etc/koremind/koremind.env  (chmod 640, owner root, group koremind)
# Absolute path: the default (./data) depends on the working directory.
KOREMIND_DATA_DIR=/var/lib/koremind
KOREMIND_PORT=8787
KOREMIND_WEB_PORT=3210

# Providers on offer, in the order the apps show them: claude, opencode, opencode-go.
# They are signed in here on the server, never in the apps. Claude is the owner's only (it runs on their subscription).
KOREMIND_PROVIDERS=claude

# Claude Code CLI, signed in once as the service user: sudo -iu koremind bash -c '~/.local/bin/claude auth login'
KOREMIND_CLAUDE_BIN=/home/koremind/.local/bin/claude
# A separate Claude login folder for KoreMind (then: CLAUDE_CONFIG_DIR=<folder> claude auth login). Empty = ~/.claude.
#KOREMIND_CLAUDE_CONFIG_DIR=

# Only with opencode / opencode-go in KOREMIND_PROVIDERS. Full path to the OpenCode v2 binary.
#KOREMIND_OPENCODE_BIN=/home/koremind/.opencode/bin/opencode
# Signs in OpenCode Go (your Go subscription).
#OPENCODE_API_KEY=

# Listen address. 127.0.0.1 when only a tunnel or proxy on this machine may reach the backend
# (needed with KOREMIND_TRUST_PROXY=1, so nobody else can set x-forwarded-for).
#KOREMIND_HOST=127.0.0.1

# Set when KoreMind is reachable at a public address (Cloudflare tunnel, your own domain).
# It is shown by the backend and put into phone-pairing QR codes.
#KOREMIND_PUBLIC_URL=https://api.koremind.example.com

# When a proxy on ANOTHER machine terminates TLS in front of KoreMind, or a tunnel on this one with KOREMIND_HOST=127.0.0.1.
#KOREMIND_TRUST_PROXY=1

# --- Kore ID single sign-on (see docs/kore-id.md). REQUIRED: it is the only way anyone signs in. ---
# With KOREMIND_OIDC_ISSUER empty the backend starts, but nobody can sign in.
#KOREMIND_OIDC_ISSUER=https://id.kore.example
#KOREMIND_OIDC_CLIENT_ID=koremind
# The client secret Kore ID printed for "koremind". Keep this file chmod 640. Or point at a file instead:
#KOREMIND_OIDC_CLIENT_SECRET=
#KOREMIND_OIDC_CLIENT_SECRET_FILE=/etc/koremind/oidc-secret
# Default: $KOREMIND_PUBLIC_URL/auth/callback. Register exactly this in Kore ID.
#KOREMIND_OIDC_REDIRECT_URI=https://api.koremind.example.com/auth/callback
# Where the web UI lives (comma separated origins). Default: localhost only.
#KOREMIND_WEB_ORIGINS=https://koremind.example.com
# Register in Kore ID's clients.json for "koremind": redirectUris = the redirect URI above, and
# backchannelLogoutUri = $KOREMIND_PUBLIC_URL/auth/backchannel-logout (the backend logs both on start).
# Who gets an account: by default anyone Kore ID lets into KoreMind (Kore ID's per-user app access decides).
#KOREMIND_OIDC_AUTO_PROVISION=0
# Optional extra filter on top of that (emails or @domains):
#KOREMIND_OIDC_ALLOWED_EMAILS=me@example.com,@family.example
# Who becomes the owner of an EMPTY KoreMind: by default the first account. Pin it (recommended for a fresh install):
#KOREMIND_OIDC_OWNER_EMAIL=me@example.com
# A first Kore ID sign-in links to the existing local account with the same email when Kore ID marks it verified
# (it always does: admins create the accounts). On by default; 0 = only link by hand (Settings -> Account -> Link Kore ID).
# (Old name: KOREMIND_OIDC_TRUST_EMAIL_LINK, still read.)
#KOREMIND_OIDC_EMAIL_LINK=0
# The other Kore apps, for the web UI's app switcher and account menu:
#KOREMIND_KORE_APPS=kore=https://files.example.com,korecalendar=https://cal.example.com,flatline=https://status.example.com
