{
    "name": "@kore/monitor",
    "version": "2.0.0",
    "private": true,
    "description": "KoreMonitor — Rust backend, Go fleet agent and backup agent, Next.js web app.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qarasky/kore.git",
        "directory": "apps/kore-monitor"
    },
    "//": "Node is a build/test tool here and the web app's runtime (apps/web, its own image); the backend is Rust and the agents are Go.",
    "scripts": {
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check .",
        "test:web": "bun run --cwd apps/web test",
        "typecheck:web": "bun run --cwd apps/web typecheck",
        "build:web": "bun run --cwd apps/web build"
    },
    "devDependencies": {
        "prettier": "^3.8.1"
    }
}
