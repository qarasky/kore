{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_URL",
        "KORE_ID_URL",
        "KOREMONITOR_BUILD_ID",
        "FLATLINE_BUILD_ID",
        "KOREMONITOR_DEV_ORIGINS",
        "FLATLINE_DEV_ORIGINS",
        "KOREMIND_STANDALONE"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "env": [
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
